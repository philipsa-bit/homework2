<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<p>
  Sorted by <%= @sort.humanize.downcase %>
  (<%= @direction == "asc" ? "ascending" : "descending" %>)
</p>

<% title_direction = @sort == "title" && @direction == "asc" ? "desc" : "asc" %>
<% rating_direction = @sort == "rating" && @direction == "asc" ? "desc" : "asc" %>
<% date_direction = @sort == "release_date" && @direction == "asc" ? "desc" : "asc" %>

<table class="sort-<%= @sort %> <%= @direction %>">
  <thead>
  <tr>
    <th class="<%= "sorted-#{@direction}" if @sort == "title" %>">
      <%= link_to "Title", movies_path(sort: "title", direction: title_direction) %>
    </th>
    <th class="<%= "sorted-#{@direction}" if @sort == "rating" %>">
      <%= link_to "Rating", movies_path(sort: "rating", direction: rating_direction) %>
    </th>
    <th class="<%= "sorted-#{@direction}" if @sort == "release_date" %>">
      <%= link_to "Release date", movies_path(sort: "release_date", direction: date_direction) %>
    </th>
  </tr>
  </thead>

  <tbody>
  <% @movies.each do |movie| %>
    <tr>
      <td class="<%= "sorted-#{@direction}" if @sort == "title" %>">
        <%= movie.title %>
      </td>
      <td class="<%= "sorted-#{@direction}" if @sort == "rating" %>">
        <%= movie.rating %>
      </td>
      <td class="<%= "sorted-#{@direction}" if @sort == "release_date" %>">
        <%= movie.release_date %>
      </td>
    </tr>
  <% end %>
  </tbody>

  <tfoot>
  <tr>
    <td colspan="3">Movie List</td>
  </tr>
  </tfoot>
</table>

<%= link_to "New movie", new_movie_path %>
